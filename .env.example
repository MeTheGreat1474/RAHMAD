# Local LLM Configuration
USE_LOCAL_LLM=true
LOCAL_LLM_URL=http://your-url-here
LOCAL_LLM_MODEL=qwen2.5:7b
LOCAL_LLM_MODEL_FALLBACK=llama3:8b

# OpenRouter LLM Configuration
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_MODEL_FALLBACK=z-ai/glm-5.3-flash,stealth/space-bunny-alpha,deepseek/deepseek-v4-flash-0731

JUDGE_MODEL=deepseek/deepseek-v4.1-flash
JUDGE_MODEL_FALLBACK=deepseek/deepseek-v4.1-flash,z-ai/glm-5.3-flash,stealth/space-bunny-alpha,deepseek/deepseek-v4-flash-0731
JUDGE_MODE=single  # options: single, panel, self_consistency

# Reverse Image Search
SERPAPI_API_KEY=your-key-here

# Image File Hosting
IMGBB_API_KEY=your-key-here



# Local LLM Configuration
USE_LOCAL_LLM=true
LOCAL_LLM_URL=http://your-url-here
LOCAL_LLM_MODEL=qwen2.5:7b
LOCAL_LLM_MODEL_FALLBACK=llama3:8b

# OpenRouter LLM Configuration
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_MODEL_FALLBACK=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,inclusionai/ling-3.0-flash:free,poolside/laguna-m.1:free

JUDGE_MODEL=deepseek/deepseek-v4-flash-0731
JUDGE_MODEL_FALLBACK=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,inclusionai/ling-3.0-flash:free,poolside/laguna-m.1:free

# Reverse Image Search
SERPAPI_API_KEY=your-key-here

# Image File Hosting
IMGBB_API_KEY=your-key-here

